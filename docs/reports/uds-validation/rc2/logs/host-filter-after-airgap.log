-A DOCKER -d 172.19.0.3/32 ! -i br-81f7bd28ea41 -o br-81f7bd28ea41 -p tcp -m tcp --dport 6443 -j ACCEPT
-A DOCKER -d 172.19.0.3/32 ! -i br-81f7bd28ea41 -o br-81f7bd28ea41 -p tcp -m tcp --dport 443 -j ACCEPT
-A DOCKER -d 172.19.0.3/32 ! -i br-81f7bd28ea41 -o br-81f7bd28ea41 -p tcp -m tcp --dport 80 -j ACCEPT
-A DOCKER -d 172.18.0.3/32 ! -i br-26325eb923fd -o br-26325eb923fd -p tcp -m tcp --dport 6443 -j ACCEPT
-A DOCKER -d 172.18.0.3/32 ! -i br-26325eb923fd -o br-26325eb923fd -p tcp -m tcp --dport 443 -j ACCEPT
-A DOCKER -d 172.18.0.3/32 ! -i br-26325eb923fd -o br-26325eb923fd -p tcp -m tcp --dport 80 -j ACCEPT
-A DOCKER ! -i docker0 -o docker0 -j DROP
