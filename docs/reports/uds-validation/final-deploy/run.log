variables:
- name: CAMERA_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for edge to optional GS_MJPEG_URL HTTP(S) camera pull. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: CAMERA_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for CAMERA_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "80"
- name: DOMAIN
  pattern: ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$
  description: Must match UDS Core DOMAIN.
  default: uds.dev
- name: EDGE_AUTH_SECRET
  pattern: ^[a-z0-9]([-a-z0-9]{0,251}[a-z0-9])?$
  description: Existing Secret containing edge authentication material.
  default: edge-auth
- name: EDGE_GATEWAY_HOST
  pattern: ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$
  description: Ship tenant gateway subdomain.
  default: edge
- name: EDGE_ID
  description: Edge identifier (edge component).
  default: edge-1
- name: EDGE_MAX_BYTES
  description: Maximum retained edge form payload bytes; 0 is unlimited.
  default: "0"
- name: EDGE_MAX_ITEMS
  description: Maximum retained edge items; 0 is unlimited.
  default: "0"
- name: EDGE_OPERATOR_TOKEN_KEY
  pattern: ^[a-zA-Z0-9._-]+$
  description: Key in EDGE_AUTH_SECRET for operator-token.
  default: operator-token
- name: EDGE_PUBLIC_HOSTS
  description: Host names the edge answers to.
  default: edge,edge.ghost-seeker-ship.svc.cluster.local,edge.uds.dev
- name: EDGE_STORAGE
  description: Edge SQLite persistent volume size.
  default: 10Gi
- name: EDGE_STORAGE_CLASS
  description: edge data PVC StorageClass; empty uses the cluster default.
- name: EDGE_TLS_SECRET
  pattern: ^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Optional existing kubernetes.io/tls Secret for edge; empty keeps HTTP.
- name: EDGE_UNIT_TOKEN_KEY
  pattern: ^[a-zA-Z0-9._-]+$
  description: Key in EDGE_AUTH_SECRET for unit-token.
  default: unit-token
- name: FRAMES_HOSTPATH
  description: Node directory mounted read-only at /frames in the edge pod (sensor frame drop). Production images have no replay; the edge ingests the live input stream.
  default: /var/lib/ghost-seeker/frames
- name: FRAMES_SOURCE
  pattern: ^(hostPath|pvc)$
  description: Frames volume source; UDS requires pvc.
  default: pvc
- name: FRAMES_STORAGE
  description: Frames PVC capacity.
  default: 10Gi
- name: FRAMES_STORAGE_CLASS
  description: Frames PVC storage class; empty uses the cluster default.
- name: INFERENCE_CPU_LIMIT
  pattern: ^[1-9][0-9]*(m)?$
  description: Inference cpu limit; tune for approved hardware.
  default: "4"
- name: INFERENCE_CPU_REQUEST
  pattern: ^[1-9][0-9]*(m)?$
  description: Inference cpu request; tune for approved hardware.
  default: 500m
- name: INFERENCE_MEMORY_LIMIT
  pattern: ^[1-9][0-9]*(Mi|Gi|Ti)$
  description: Inference memory limit; tune for approved hardware.
  default: 4Gi
- name: INFERENCE_MEMORY_REQUEST
  pattern: ^[1-9][0-9]*(Mi|Gi|Ti)$
  description: Inference memory request; tune for approved hardware.
  default: 1Gi
- name: INFER_URL
  description: Edge inference sidecar URL (required; prod images have no built-in analyzer stand-in).
  default: http://edgeml-sidecar:9090
- name: MODEL_DETECTOR
  pattern: "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*(/[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*)*$"
  description: Approved detector path relative to /models.
  default: yolo11n-640/model.onnx
- name: MODEL_EMBED
  pattern: "^[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*(/[a-zA-Z0-9_-]+(\\.[a-zA-Z0-9_-]+)*)*$"
  description: Embedding directory relative to /models, or none to disable.
  default: mobileclip-s1
- name: MODEL_SHA256
  pattern: ^([a-fA-F0-9]{64})?$
  description: SHA256 of the approved model image SHA256SUMS file; required for inference readiness.
  default: 41f9db8eaaa64a34803f1a145468d80a66910ad63572ddf24b9c9c95d6fb4875
- name: NAMESPACE
  pattern: ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Application namespace; create it and auth Secrets before deploying.
  default: ghost-seeker-ship
- name: SHORE_CA_SECRET
  pattern: ^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Optional existing Secret with ca.crt PEM roots for edge and operator shore/edge clients; empty uses system roots.
- name: SHORE_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for edge/operator to routed shore sync, console and API. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: SHORE_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for SHORE_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "443"
- name: SHORE_TLS_SECRET
  pattern: ^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Optional existing kubernetes.io/tls Secret for shore; empty keeps HTTP. Setting this also upgrades the default local shore URLs to HTTPS.
- name: SHORE_TRANSPORT
  pattern: ^external$
  description: Split packages always synchronize through the TLS gateway, including on a shared cluster.
  default: external
- name: SHORE_URL
  description: Edge-to-shore URL; its default switches to HTTPS with SHORE_TLS_SECRET. Custom URLs must explicitly use https for TLS endpoints.
  default: https://shore.uds.dev:443
