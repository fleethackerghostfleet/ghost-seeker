apiVersion: zarf.dev/v1alpha1
kind: ZarfPackageConfig
metadata:
  name: ghost-seeker-shore
  description: Production shore on an existing UDS Core 1.16 cluster; pre-existing authentication Secrets required.
  version: 0.1.0
  architecture: amd64
  aggregateChecksum: f7eef1a08aac0c79ae7f6f0a97a077d1a580160e57ba28f762bdc34a6c149e41
  annotations:
    dev.uds.bundle.name: ghost-seeker-shore
    dev.uds.bundle.version: 0.1.0
  allowNamespaceOverride: true
build:
  architecture: amd64
  timestamp: Fri, 06 Nov 2026 16:32:36 +0000
  version: v0.89.0
  migrations:
  - scripts-to-actions
  - pluralize-set-variable
  signed: false
  provenanceFiles:
  - checksums.txt
components:
- name: namespace
  required: true
  manifests:
  - name: namespace
    namespace: default
    files:
    - namespace-0.yaml
    template: true
- name: uds-package
  required: true
  manifests:
  - name: uds-package
    namespace: default
    files:
    - uds-package-0.yaml
    template: true
  actions:
    onDeploy:
      before:
      - cmd: |
          if [ -n "${ZARF_VAR_SHORE_TLS_SECRET:-}" ] || [ -n "${ZARF_VAR_EDGE_TLS_SECRET:-}" ]; then
            echo "UDS listeners must remain HTTP behind STRICT mTLS; TLS terminates at the gateway." >&2
            exit 1
          fi
        template: false
- name: shore
  required: true
  manifests:
  - name: shore
    namespace: default
    files:
    - shore-0.yaml
    template: true
  images:
  - ghost-seeker/shore:prod-b0b377607950-20261106163143-7d98ece6
- name: operator
  required: true
  manifests:
  - name: operator
    namespace: default
    files:
    - operator-0.yaml
    template: true
  images:
  - ghost-seeker/operator:prod-b0b377607950-20261106163143-7d98ece6
variables:
- name: DOMAIN
  pattern: ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$
  description: Must match UDS Core DOMAIN.
  default: uds.dev
- name: EDGE_TLS_SECRET
  pattern: ^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Optional existing kubernetes.io/tls Secret for edge; empty keeps HTTP.
- name: INFERENCE_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for edge/shore to remote inference or text embedding. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: INFERENCE_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for INFERENCE_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "9090"
- name: LLM_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for operator to optional GS_LLM_URL OpenAI-compatible endpoint or approved Vertex gateway. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: LLM_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for LLM_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "8080"
- name: NAMESPACE
  pattern: ^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Application namespace; create it and auth Secrets before deploying.
  default: ghost-seeker-shore
- name: OCSP_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for operator to optional GS_PIV_OCSP_URL responder. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: OCSP_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for OCSP_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "80"
- name: OPERATOR_AUTH_SECRET
  pattern: ^[a-z0-9]([-a-z0-9]{0,251}[a-z0-9])?$
  description: Existing Secret containing operator authentication material.
  default: operator-auth
- name: OPERATOR_GATEWAY_HOST
  pattern: ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$
  description: Operator tenant gateway subdomain.
  default: ghost-seeker
- name: OPERATOR_OPERATOR_TOKEN_KEY
  pattern: ^[a-zA-Z0-9._-]+$
  description: Key in OPERATOR_AUTH_SECRET for operator-token.
  default: operator-token
- name: OPERATOR_SHORE_URL
  description: Operator upstream shore URL; its default switches to HTTPS with SHORE_TLS_SECRET. Custom URLs must explicitly use https for TLS endpoints.
  default: http://shore:8080
- name: OPERATOR_STORAGE
  pattern: ^[1-9][0-9]*(Mi|Gi|Ti)$
  description: Operator review log PVC size.
  default: 1Gi
- name: OPERATOR_STORAGE_CLASS
  description: operator data PVC StorageClass; empty uses the cluster default.
- name: RESEARCH_EGRESS_CIDR
  pattern: ^([^/]+)/([1-9][0-9]?)$
  description: Approved destination CIDR for operator to optional GS_RESEARCH_COMPILER_URL service. Documentation-only default; set a narrow site CIDR (never 0.0.0.0/0 or ::/0).
  default: 192.0.2.0/32
- name: RESEARCH_EGRESS_PORT
  pattern: ^[1-9][0-9]{0,4}$
  description: TCP destination port for RESEARCH_EGRESS_CIDR; match the configured endpoint, TLS gateway or proxy.
  default: "8097"
- name: SHORE_AUTH_SECRET
  pattern: ^[a-z0-9]([-a-z0-9]{0,251}[a-z0-9])?$
  description: Existing Secret containing shore authentication material.
  default: shore-auth
- name: SHORE_CA_SECRET
  pattern: ^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$
  description: Optional existing Secret with ca.crt PEM roots for edge and operator shore/edge clients; empty uses system roots.
- name: SHORE_GATEWAY_HOST
  pattern: ^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$
  description: Shore tenant gateway subdomain.
  default: shore
- name: SHORE_INFER_URL
  description: Shore text-embedding inference URL; empty disables text search.
- name: SHORE_OPERATOR_TOKEN_KEY
  pattern: ^[a-zA-Z0-9._-]+$
  description: Key in SHORE_AUTH_SECRET for operator-token.
  default: operator-token
- name: SHORE_PUBLIC_HOSTS
  description: Host names the shore answers to; must include the host of SHORE_URL and any ingress name.
  default: shore,shore.ghost-seeker-shore,shore.ghost-seeker-shore.svc,shore.ghost-seeker-shore.svc.cluster.local
- name: SHORE_REQUIRE_AUTH
  pattern: ^true$
  description: Require HS256 unit authentication on shore SyncService (production default; the shore-auth secret must carry signing-key and operator-token).
  default: "true"
- name: SHORE_SIGNING_KEY_KEY
  pattern: ^[a-zA-Z0-9._-]+$
  description: Key in SHORE_AUTH_SECRET for signing-key.
