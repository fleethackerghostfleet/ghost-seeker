kind: ZarfPackageConfig
metadata:
  name: ghost-seeker-ship
  description: Production ship on an existing UDS Core 1.16 cluster; pre-existing authentication Secrets required.
  version: 0.1.0
  architecture: amd64
  aggregateChecksum: 07eadee25d5b8124e1eabe6c711d45724e4e00667e2e67f5da5d6df12d8c2afd
