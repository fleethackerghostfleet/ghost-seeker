    - namespace-0.yaml
    template: true
- name: uds-package
  required: true
  manifests:
  - name: uds-package
    namespace: default
    files:
    - uds-package-0.yaml
    template: true
  actions:
    onDeploy:
      before:
      - cmd: |
          if [ -n "${ZARF_VAR_SHORE_TLS_SECRET:-}" ] || [ -n "${ZARF_VAR_EDGE_TLS_SECRET:-}" ]; then
            echo "UDS listeners must remain HTTP behind STRICT mTLS; TLS terminates at the gateway." >&2
            exit 1
          fi
          [ "${ZARF_VAR_FRAMES_SOURCE:-}" = pvc ] || { echo "UDS requires FRAMES_SOURCE=pvc" >&2; exit 1; }
          case "${ZARF_VAR_SHORE_TRANSPORT:-}" in
            external)
              case "${ZARF_VAR_SHORE_URL:-}" in https://*:443) ;; *) echo "External shore requires https://host:443 and HTTP/2" >&2; exit 1 ;; esac
              ;;
            *) exit 1 ;;
          esac
        template: false
